GEMINI_API_KEY=
APP_URL=

# El servidor solo habilita la cuenta de administración con un secreto nuevo.
MU_ADMIN_PASSWORD=
# Opcional: orígenes HTTPS de la PWA permitidos, separados por comas.
MU_WORLD_ORIGINS=
# Opcional: archivo absoluto en un volumen persistente.
MU_WORLD_FILE=
# Opcional al compilar Pages: URL HTTPS del servidor Node.
VITE_WORLD_SERVER_URL=
# Servidor HTTPS común al compilar la web y APK-WEB (por defecto VITE_WORLD_SERVER_URL).
VITE_BACKUP_URL=
# Servidor Node: almacenamiento privado persistente y orígenes exactos.
MU_BACKUP_DIR=
MU_BACKUP_ORIGINS=https://jesusalejando725.github.io
# 32 bytes aleatorios en hexadecimal (openssl rand -hex 32). Mantén una copia privada.
MU_RECOVERY_KEY=
# Si hay proxy inverso local, limita la confianza al proxy (p. ej. loopback).
MU_TRUST_PROXY=
